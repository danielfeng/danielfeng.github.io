// Gruvbox Dark palette (https://github.com/morhetz/gruvbox)
$gb-bg0-h  = #1d2021;
$gb-bg0    = #282828;
$gb-bg1    = #3c3836;
$gb-bg2    = #504945;
$gb-bg3    = #665c54;
$gb-bg4    = #7c6f64;
$gb-gray   = #928374;
$gb-fg4    = #a89984;
$gb-fg3    = #bdae93;
$gb-fg2    = #d5c4a1;
$gb-fg1    = #ebdbb2;
$gb-fg0    = #fbf1c7;
$gb-red    = #fb4934;
$gb-green  = #b8bb26;
$gb-yellow = #fabd2f;
$gb-blue   = #83a598;
$gb-purple = #d3869b;
$gb-aqua   = #8ec07c;
$gb-orange = #fe8019;

// Core colors (NexT exposes these as CSS variables)
$body-bg-color             = $gb-bg0-h;
$content-bg-color          = $gb-bg0;
$card-bg-color             = $gb-bg1;
$menu-item-bg-color        = $gb-bg1;
$text-color                = $gb-fg1;
$link-color                = $gb-yellow;
$link-hover-color          = $gb-orange;
$link-decoration-color     = $gb-bg3;
$blockquote-color          = $gb-fg4;
$border-color              = $gb-bg2;
$selection-bg              = $gb-bg3;
$selection-color           = $gb-fg0;
$brand-color               = $gb-fg1;
$brand-hover-color         = $gb-yellow;
$table-row-odd-bg-color    = $gb-bg0;
$table-row-hover-bg-color  = $gb-bg1;
$table-border-color        = $gb-bg2;
$table-cell-border-bottom-color = $gb-bg2;
$grey-lighter              = $gb-bg2;

$btn-default-bg            = $gb-bg1;
$btn-default-color         = $gb-fg1;
$btn-default-border-color  = $gb-bg3;
$btn-default-hover-bg      = $gb-yellow;
$btn-default-hover-color   = $gb-bg0;
$btn-default-hover-border-color = $gb-yellow;

$pagination-border         = $gb-bg2;
$pagination-link-color     = $gb-fg1;
$pagination-link-border    = $gb-bg2;
$pagination-link-hover-color = $gb-yellow;
$pagination-active-bg      = $gb-yellow;
$pagination-active-color   = $gb-bg0;
$pagination-active-border  = $gb-yellow;

$subtitle-color            = $gb-fg4;
$site-subtitle-color       = $gb-fg4;
$site-description-color    = $gb-fg4;
$site-state-item-name-color = $gb-fg4;
$site-author-name-color    = $gb-fg1;
$site-author-image-border-color = $gb-bg2;
$sidebar-nav-color         = $gb-fg2;
$sidebar-nav-hover-color   = $gb-orange;
$sidebar-highlight         = $gb-orange;
$headband-bg               = $gb-orange;

$b2t-color                 = $gb-bg0;
$b2t-bg-color              = $gb-yellow;
$badge-background          = $gb-bg2;
$badge-color               = $gb-fg1;

$tag-cloud-start           = $gb-fg4;
$tag-cloud-end             = $gb-yellow;

$box-shadow-inner          = none;
$box-shadow                = none;
$border-radius-inner       = 6px;
$border-radius             = 6px;

// Typography: comfortable CJK reading
$font-family-chinese    = 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Noto Sans CJK SC', 'Noto Sans SC', 'Source Han Sans SC', 'WenQuanYi Micro Hei';
$font-family-base       = -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, $font-family-chinese, sans-serif;
$font-family-logo       = $font-family-base;
$font-family-headings   = $font-family-base;
$font-family-posts      = $font-family-base;
$font-family-monospace  = 'JetBrains Mono', 'Fira Code', 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace, $font-family-chinese;
$code-font-family       = $font-family-monospace;
$line-height-base       = 1.85;
